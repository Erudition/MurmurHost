{
    "name": "mumble-bot",
    "version": "1.0.0",
    "description": "A bot for mumble.",
    "main": "index.js",
    "scripts": {
        "build:web": "webpack || true",
        "build:server": "tsc -p tsconfig-production.json --skipLibCheck || true",
        "build:web:release": "webpack --config webpack.config-release.js || true",
        "start:web": "webpack-dev-server",
        "start:server": "TZ=UTC nodemon",
        "start:worker": "TZ=UTC node server worker --config-file config.yml",
        "lint:src": "eslint --ext .ts \"src/**/*.ts\"",
        "lint:style": "stylelint src/**/*.scss",
        "test": "TZ=UTC jest --runInBand --config jest/jest-unit-config.json",
        "test:integration": "TZ=UTC jest --config jest/jest-integration-config.json"
    },
    "nodemonConfig": {
        "ignore": [
            "data/**/*",
            "dist/**/*",
            "server/**/*"
        ],
        "ext": "ts",
        "watch": [
            "src"
        ],
        "exec": "yarn build:server && node server serve --config-file config.yml"
    },
    "repository": "https://git.cronosx.de/prior/mumble-bot",
    "author": "Frederick <frederick@gnodtke.net>",
    "license": "GPL-3.0",
    "dependencies": {
        "body-parser": "1.19.0",
        "canvas": "^2.6.1",
        "chunking-streams": "^0.0.8",
        "classnames": "^2.2.6",
        "clime": "^0.5.14",
        "color": "^3.1.3",
        "date-fns": "1",
        "decko": "^1.2.0",
        "express": "4.17.1",
        "express-ws": "^4.0.0",
        "fft-js": "^0.0.12",
        "fluent-ffmpeg": "^2.1.2",
        "fs-extra": "7",
        "gravatar-url": "^3.1.0",
        "history": "^4.10.1",
        "hyrest": "^0.11.0",
        "hyrest-express": "^0.1.6",
        "mkdirp": "^1.0.4",
        "mobx": "5",
        "mobx-react": "5",
        "morgan": "1.10.0",
        "mumble": "0.3.21",
        "node-telegram-bot-api": "^0.50.0",
        "nodemon": "^2.0.5",
        "path-to-regexp": "^6.2.0",
        "pg": "^8.4.1",
        "promise-mysql": "^4.1.3",
        "ramda": "^0.27.0",
        "react": "^16.14.0",
        "react-dom": "^16.14.0",
        "react-router": "^5.2.0",
        "react-router-dom": "^5.2.0",
        "react-semantic-ui-range": "^0.7.0",
        "recharts": "^1.8.5",
        "rxjs": "^6.6.3",
        "semantic-ui-react": "^0.88.2",
        "sox-stream": "^2.0.6",
        "tsdi": "^0.25.0",
        "typeorm": "0.2.28",
        "uuid": "^8.3.1",
        "winston": "^3.3.3",
        "ws": "^7.3.1",
        "yamljs": "^0.3.0",
        "youtube-dl": "^3.0.2"
    },
    "devDependencies": {
        "@types/body-parser": "^1.19.0",
        "@types/classnames": "^2.2.10",
        "@types/color": "^3.0.1",
        "@types/express-ws": "^3.0.0",
        "@types/fluent-ffmpeg": "^2.1.16",
        "@types/fs-extra": "7",
        "@types/gravatar-url": "^3.0.2",
        "@types/jest": "^26.0.14",
        "@types/morgan": "^1.9.1",
        "@types/node": "10",
        "@types/node-telegram-bot-api": "^0.50.4",
        "@types/puppeteer": "^3.0.2",
        "@types/ramda": "=0.27.6",
        "@types/react": "^16.9.52",
        "@types/recharts": "^1.8.16",
        "@types/supertest": "^2.0.10",
        "@types/uuid": "^8.3.0",
        "@types/winston": "^2.4.4",
        "@types/yamljs": "^0.2.31",
        "@types/youtube-dl": "^1.12.2",
        "@typescript-eslint/eslint-plugin": "^4.4.1",
        "@typescript-eslint/parser": "^4.4.1",
        "concurrently": "^5.3.0",
        "css-loader": "^3.5.3",
        "eslint": "^7.11.0",
        "eslint-config-prettier": "^6.12.0",
        "eslint-plugin-filenames": "^1.3.2",
        "eslint-plugin-import": "^2.22.1",
        "eslint-plugin-jest": "^24.1.0",
        "eslint-plugin-jsdoc": "^30.6.5",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-prettier": "^3.1.4",
        "extract-text-webpack-plugin": "^4.0.0-beta.0",
        "file-loader": "^6.1.1",
        "git-revision-webpack-plugin": "^3.0.6",
        "identity-obj-proxy": "^3.0.0",
        "jest": "26.5.3",
        "jest-localstorage-mock": "^2.4.3",
        "jest-screenshot": "^0.3.1",
        "node-sass": "^4.14.1",
        "prettier": "^2.1.2",
        "progress-bar-webpack-plugin": "^2.1.0",
        "puppeteer": "5.3.1",
        "resolve-url-loader": "^3.1.1",
        "sass-loader": "^8.0.2",
        "stylelint": "^13.7.2",
        "supertest": "^5.0.0",
        "ts-jest": "26.4.1",
        "ts-loader": "^7.0.5",
        "typescript": "4.0.3",
        "webpack": "^4.43.0",
        "webpack-cli": "^3.3.11",
        "webpack-dev-server": "^3.11.0"
    },
    "resolutions": {
        "@types/recharts/@types/react": "^16.9.52",
        "@types/recharts/@types/d3-shape": "^1.2.6"
    }
}